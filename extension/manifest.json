{
  "manifest_version": 3,
  "name": "It's My Bib",
  "version": "1.0.0",
  "description": "Local-first portable backup/restore for your own MyBib projects. Exports editable working data as one JSON file; nothing leaves your machine.",
  "author": "Cheah Pin Chee",
  "homepage_url": "https://github.com/cheahpc",
  "minimum_chrome_version": "109",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "It's My Bib",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://www.mybib.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.mybib.com/*"
      ],
      "js": [
        "src/common/schema.js",
        "src/content/adapter.js",
        "src/content/restore.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
